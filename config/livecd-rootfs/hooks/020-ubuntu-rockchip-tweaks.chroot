#!/bin/bash

set -ex

. /root/config/chroot

# This hook is injected into the livecd-rootfs of the suite being built by
# scripts/build-rootfs.sh. It does what the rockchip fork of livecd-rootfs does
# for the older suites, and in addition ships the files that the PPA only
# ubuntu-rockchip-settings packages would have installed.

# Disable terminal ads
if command -v pro > /dev/null; then
    pro config set apt_news=false
fi

# Disable apport bug reporting
if [ -f /etc/default/apport ]; then
    sed -i 's/enabled=1/enabled=0/g' /etc/default/apport
fi

# Remove release upgrade motd
rm -f /var/lib/ubuntu-release-upgrader/release-upgrade-available
if [ -f /etc/update-manager/release-upgrades ]; then
    sed -i 's/Prompt=.*/Prompt=never/g' /etc/update-manager/release-upgrades
fi

# Let systemd create machine id on first boot
rm -f /var/lib/dbus/machine-id
true > /etc/machine-id

# Disable grub, these boards boot through U-Boot and extlinux
rm -rf /boot/grub

# Disable motd news
if [ -f /etc/default/motd-news ]; then
    sed -i 's/ENABLED=1/ENABLED=0/g' /etc/default/motd-news
fi

# Add new users to the video group
sed -i 's/#EXTRA_GROUPS=.*/EXTRA_GROUPS="video"/g' /etc/adduser.conf
sed -i 's/#ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/g' /etc/adduser.conf

# U-Boot loads the initrd as is, so keep it to a format every rockchip U-Boot
# build can hand over to the kernel (ubuntu-rockchip-settings)
mkdir -p /etc/initramfs-tools/conf.d
echo "COMPRESS=gzip" > /etc/initramfs-tools/conf.d/rockchip-gzip.conf

# Soft blocked radios should come up unblocked (ubuntu-rockchip-settings)
mkdir -p /etc/modprobe.d
(
    echo "options rfkill master_switch_mode=2"
    echo "options rfkill default_state=1"
) > /etc/modprobe.d/rfkill.conf

# The serial console is the primary console on most of these boards
# (ubuntu-rockchip-settings)
mkdir -p /usr/lib/systemd/system/serial-getty@.service.d
(
    echo "[Service]"
    echo "Environment=TERM=linux"
) > /usr/lib/systemd/system/serial-getty@.service.d/10-term.conf

# Override u-boot-menu config
mkdir -p /usr/share/u-boot-menu/conf.d
cat << 'EOF' > /usr/share/u-boot-menu/conf.d/ubuntu.conf
U_BOOT_PROMPT="1"
U_BOOT_PARAMETERS="$(cat /etc/kernel/cmdline)"
U_BOOT_TIMEOUT="20"
EOF

# Default kernel command line arguments, the board config hook in
# config/boards replaces the console with the one wired up on the board
mkdir -p /etc/kernel
echo -n "rootwait rw console=ttyS2,1500000 console=tty1 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory" > /etc/kernel/cmdline

if [ "$SUBPROJECT" == "desktop-preinstalled" ]; then
    # The cloud-init will not allow for user groups to be assigned on the first login
    apt-get -y purge cloud-init

    # Prepare required oem installer paths
    mkdir -p /var/log/installer
    touch /var/log/installer/debug
    touch /var/log/syslog
    chown syslog:adm /var/log/syslog

    # Create the oem user account only if it doesn't already exist
    if ! id "oem" &>/dev/null; then
        /usr/sbin/useradd -d /home/oem -G adm,sudo,video -m -N -u 29999 oem
        /usr/sbin/oem-config-prepare --quiet
        touch "/var/lib/oem-config/run"
    fi

    # Create host ssh keys
    ssh-keygen -A

    # Adjust kernel command line arguments for desktop
    echo -n " quiet splash plymouth.ignore-serial-consoles" >> /etc/kernel/cmdline
else
    # Seed cloud-init from the CIDATA partition written by
    # scripts/build-image.sh (ubuntu-rockchip-settings-server)
    mkdir -p /etc/cloud/cloud.cfg.d
    cat << 'EOF' > /etc/cloud/cloud.cfg.d/99-fake-cloud.cfg
# configure cloud-init for NoCloud
datasource_list: [ NoCloud, None ]
datasource:
  NoCloud:
    fs_label: CIDATA
EOF

    # Wait for cloud-init to finish (creating users, etc.) before running getty
    mkdir -p /etc/systemd/system/cloud-config.service.d
    (
        echo "[Unit]"
        echo "Before=getty.target"
    ) > /etc/systemd/system/cloud-config.service.d/getty-wait.conf
fi

# Remove misc packages, flash-kernel would fight u-boot-menu over /boot
apt-get -y purge flash-kernel fwupd

# Update extlinux
u-boot-update
